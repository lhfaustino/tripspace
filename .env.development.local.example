# Copy to .env.development.local. This file has higher priority than .env.local
# in `next dev` and is ignored by Git because it ends with `.local`.
# Obtain every value directly from the separate Supabase TEST project dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://TEST_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TEST_PROJECT_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TEST_PROJECT_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=TEST_PROJECT_SERVICE_ROLE_KEY

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keep unrelated development-only integrations disabled or use separate test values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
INBOUND_EMAIL_SECRET=
ENCRYPTION_KEY=REPLACE_WITH_A_DEVELOPMENT_ONLY_VALUE
